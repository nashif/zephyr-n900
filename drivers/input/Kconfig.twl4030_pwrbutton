config INPUT_TWL4030_PWRBUTTON
	bool "TI TWL4030 power button"
	default y
	depends on DT_HAS_TI_TWL4030_PWRBUTTON_ENABLED
	depends on MFD_TWL4030
	help
	  Enable the driver for the power button of the TI TWL4030 and TWL5030
	  power management chips, reported as INPUT_KEY_POWER.
