config ADP1653
	bool "ADP1653 camera flash LED driver"
	default y
	depends on DT_HAS_ADI_ADP1653_ENABLED
	select I2C
	select GPIO if $(dt_compat_any_has_prop,$(DT_COMPAT_ADI_ADP1653),enable-gpios)
	help
	  Enable the driver for the Analog Devices ADP1653 camera flash LED
	  driver: torch, indicator and flash through the LED API.
