config ACX565AKM
	bool "Sony ACX565AKM panel controller"
	default y
	depends on DT_HAS_SONY_ACX565AKM_ENABLED
	select SPI
	help
	  Enable the driver for the command interface of the Sony ACX565AKM
	  LCD panel controller: brightness and display on/off.
