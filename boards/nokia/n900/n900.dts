/dts-v1/;

#include <ti/omap3430.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/input/keymap.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/ti-omap3-pinctrl.h>

/ {
	model = "Nokia N900";
	compatible = "nokia,omap3-n900", "ti,omap3430", "ti,omap3";

	chosen {
		zephyr,sram = &sdram0;
		zephyr,display = &dispc;
	};

	sdram0: memory@80000000 {
		device_type = "memory";
		compatible = "mmio-sram";
		reg = <0x80000000 DT_SIZE_M(254)>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		camera-focus {
			gpios = <&gpio3 4 GPIO_ACTIVE_LOW>; /* GPIO 68 */
			zephyr,code = <INPUT_KEY_CAMERA_FOCUS>;
		};

		camera-capture {
			gpios = <&gpio3 5 GPIO_ACTIVE_LOW>; /* GPIO 69 */
			zephyr,code = <INPUT_KEY_CAMERA>;
		};

		lock-button {
			gpios = <&gpio4 17 GPIO_ACTIVE_LOW>; /* GPIO 113 */
			zephyr,code = <INPUT_KEY_COFFEE>;
		};

		keypad-slide {
			gpios = <&gpio3 7 GPIO_ACTIVE_LOW>; /* GPIO 71 */
			zephyr,code = <INPUT_SW_KEYPAD_SLIDE>;
			zephyr,input-type = <INPUT_EV_SW>;
		};

		proximity-sensor {
			gpios = <&gpio3 25 GPIO_ACTIVE_HIGH>; /* GPIO 89 */
			zephyr,code = <INPUT_SW_FRONT_PROXIMITY>;
			zephyr,input-type = <INPUT_EV_SW>;
		};

		camera-lens-cover {
			gpios = <&gpio4 14 GPIO_ACTIVE_LOW>; /* GPIO 110 */
			zephyr,code = <INPUT_SW_CAMERA_LENS_COVER>;
			zephyr,input-type = <INPUT_EV_SW>;
		};

		machine-cover {
			gpios = <&gpio6 0 GPIO_ACTIVE_LOW>; /* GPIO 160 */
			zephyr,code = <INPUT_SW_MACHINE_COVER>;
			zephyr,input-type = <INPUT_EV_SW>;
		};
	};

	lvgl_pointer {
		compatible = "zephyr,lvgl-pointer-input";
		input = <&touchscreen>;
	};

	/* ISP1707, enabled while GPIO 67 is high */
	usb_phy: usb-phy {
		compatible = "usb-ulpi-phy";
		#phy-cells = <0>;
		reset-gpios = <&gpio3 3 GPIO_ACTIVE_LOW>; /* GPIO 67 */
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		fb_mem: framebuffer@8fe00000 {
			reg = <0x8fe00000 DT_SIZE_M(2)>;
		};
	};
};

/* SYS_CLK, from the 19.2 MHz oscillator */
&gptimer1 {
	clock-frequency = <DT_FREQ_K(19200)>;
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&gpio4 {
	status = "okay";
};

&gpio6 {
	status = "okay";
};

&pinctrl {
	mcspi1_clk_default: mcspi1_clk_default {
		pinmux = <OMAP3_PINMUX(0x21c8, PIN_INPUT, MUX_MODE_0)>;
	};

	mcspi1_simo_default: mcspi1_simo_default {
		pinmux = <OMAP3_PINMUX(0x21ca, PIN_OUTPUT, MUX_MODE_0)>;
	};

	mcspi1_somi_default: mcspi1_somi_default {
		pinmux = <OMAP3_PINMUX(0x21cc, PIN_INPUT_PULLDOWN, MUX_MODE_0)>;
	};

	mcspi1_cs0_default: mcspi1_cs0_default {
		pinmux = <OMAP3_PINMUX(0x21ce, PIN_OUTPUT, MUX_MODE_0)>;
	};

	mcspi1_cs2_default: mcspi1_cs2_default {
		pinmux = <OMAP3_PINMUX(0x21d2, PIN_OUTPUT, MUX_MODE_0)>;
	};
};

&mcspi1 {
	status = "okay";
	pinctrl-0 = <&mcspi1_clk_default &mcspi1_simo_default &mcspi1_somi_default
		     &mcspi1_cs0_default &mcspi1_cs2_default>;
	pinctrl-names = "default";

	touchscreen: touchscreen@0 {
		compatible = "ti,tsc2005";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(6)>;
		int-gpios = <&gpio4 4 GPIO_ACTIVE_HIGH>; /* GPIO 100 */
		reset-gpios = <&gpio4 8 GPIO_ACTIVE_LOW>; /* GPIO 104 */
		ti,x-plate-ohms = <280>;
		/* Raw samples at the screen edges; Y grows towards the top */
		min-x = <204>;
		max-x = <3897>;
		min-y = <178>;
		max-y = <3763>;
		inverted-y;
		screen-width = <4096>;
		screen-height = <4096>;
		display = <&dispc>;
	};

	panel: panel@2 {
		compatible = "sony,acx565akm";
		reg = <2>;
		spi-max-frequency = <DT_FREQ_M(6)>;
	};
};

zephyr_udc0: &usb_otg {
	status = "okay";
	phys = <&usb_phy>;
	maximum-speed = "high-speed";
};

&i2c1 {
	status = "okay";

	twl: pmic@48 {
		compatible = "ti,twl4030";
		reg = <0x48>;
		/* INT1 on sys_nirq */
		interrupts = <7 0>;

		keypad {
			compatible = "ti,twl4030-keypad";
			row-size = <8>;
			col-size = <8>;

			keymap {
				compatible = "input-keymap";
				row-size = <8>;
				/* Column 8: rows that read as tied to ground */
				col-size = <9>;
				keymap = <
					MATRIX_KEY(0, 0, INPUT_KEY_Q)
					MATRIX_KEY(0, 1, INPUT_KEY_O)
					MATRIX_KEY(0, 2, INPUT_KEY_P)
					MATRIX_KEY(0, 3, INPUT_KEY_COMMA)
					MATRIX_KEY(0, 4, INPUT_KEY_BACKSPACE)
					MATRIX_KEY(0, 6, INPUT_KEY_A)
					MATRIX_KEY(0, 7, INPUT_KEY_S)
					MATRIX_KEY(1, 0, INPUT_KEY_W)
					MATRIX_KEY(1, 1, INPUT_KEY_D)
					MATRIX_KEY(1, 2, INPUT_KEY_F)
					MATRIX_KEY(1, 3, INPUT_KEY_G)
					MATRIX_KEY(1, 4, INPUT_KEY_H)
					MATRIX_KEY(1, 5, INPUT_KEY_J)
					MATRIX_KEY(1, 6, INPUT_KEY_K)
					MATRIX_KEY(1, 7, INPUT_KEY_L)
					MATRIX_KEY(2, 0, INPUT_KEY_E)
					MATRIX_KEY(2, 1, INPUT_KEY_DOT)
					MATRIX_KEY(2, 2, INPUT_KEY_UP)
					MATRIX_KEY(2, 3, INPUT_KEY_ENTER)
					MATRIX_KEY(2, 5, INPUT_KEY_Z)
					MATRIX_KEY(2, 6, INPUT_KEY_X)
					MATRIX_KEY(2, 7, INPUT_KEY_C)
					MATRIX_KEY(2, 8, INPUT_KEY_F9)
					MATRIX_KEY(3, 0, INPUT_KEY_R)
					MATRIX_KEY(3, 1, INPUT_KEY_V)
					MATRIX_KEY(3, 2, INPUT_KEY_B)
					MATRIX_KEY(3, 3, INPUT_KEY_N)
					MATRIX_KEY(3, 4, INPUT_KEY_M)
					MATRIX_KEY(3, 5, INPUT_KEY_SPACE)
					MATRIX_KEY(3, 6, INPUT_KEY_SPACE)
					MATRIX_KEY(3, 7, INPUT_KEY_LEFT)
					MATRIX_KEY(4, 0, INPUT_KEY_T)
					MATRIX_KEY(4, 1, INPUT_KEY_DOWN)
					MATRIX_KEY(4, 2, INPUT_KEY_RIGHT)
					MATRIX_KEY(4, 4, INPUT_KEY_LEFTCTRL)
					MATRIX_KEY(4, 5, INPUT_KEY_RIGHTALT)
					MATRIX_KEY(4, 6, INPUT_KEY_LEFTSHIFT)
					MATRIX_KEY(4, 8, INPUT_KEY_F10)
					MATRIX_KEY(5, 0, INPUT_KEY_Y)
					MATRIX_KEY(5, 8, INPUT_KEY_F11)
					MATRIX_KEY(6, 0, INPUT_KEY_U)
					MATRIX_KEY(7, 0, INPUT_KEY_I)
					MATRIX_KEY(7, 1, INPUT_KEY_F7)
					MATRIX_KEY(7, 2, INPUT_KEY_F8)
				>;
			};
		};

		power-button {
			compatible = "ti,twl4030-pwrbutton";
		};

		twl_gpio: gpio {
			compatible = "ti,twl4030-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <18>;
		};

		vibrator: vibrator {
			compatible = "ti,twl4030-vibra";
			duty-cycle-percent = <80>;
		};
	};
};

&i2c2 {
	status = "okay";

	/*
	 * Primary half of the TLV320AIC34 codec. Its MCLK is the 19.2 MHz
	 * system clock; HPLOUT/HPROUT and the COM outputs feed the speaker
	 * amplifier, enabled by TWL GPIO 7.
	 */
	codec: audio-codec@18 {
		compatible = "ti,tlv320aic3x";
		reg = <0x18>;
		reset-gpios = <&gpio2 28 GPIO_ACTIVE_LOW>; /* GPIO 60 */
		hp-out;
	};

	/* TSL2563 behind the front glass, next to the earpiece */
	light_sensor: light-sensor@29 {
		compatible = "ams,tsl2561";
		reg = <0x29>;
		gain = <16>;
		integration-time = <402>;
		/* The front glass passes about 1/16 of the light, as in Linux */
		glass-attenuation = <1600000>;
	};

	/* Camera flash: a white LED next to the main camera */
	flash: flash-led@30 {
		compatible = "adi,adp1653";
		reg = <0x30>;
		enable-gpios = <&gpio3 24 GPIO_ACTIVE_HIGH>; /* GPIO 88 */
		torch-max-microamp = <50000>;
		flash-max-microamp = <320000>;
		flash-timeout-us = <500000>;
	};

	/*
	 * Channels 0-3, 7 and 8 light the keyboard; 4, 5 and 6 are the blue,
	 * green and red of the status LED.
	 */
	leds: led-controller@32 {
		compatible = "national,lp5523";
		reg = <0x32>;
		enable-gpios = <&gpio2 9 GPIO_ACTIVE_HIGH>; /* GPIO 41 */
		current-microamp = <5000>;
	};

	fuel_gauge: fuel-gauge@55 {
		compatible = "ti,bq27200";
		reg = <0x55>;
	};

	charger: charger@6b {
		compatible = "ti,bq24150a";
		reg = <0x6b>;
		constant-charge-current-max-microamp = <650000>;
		constant-charge-voltage-max-microvolt = <4200000>;
		charge-term-current-microamp = <100000>;
		input-current-limit-microamp = <500000>;
		ti,sense-resistor-micro-ohms = <68000>;
	};
};

&i2c3 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;

	accelerometer: accelerometer@1d {
		compatible = "st,lis302dl";
		reg = <0x1d>;
		irq-gpios = <&gpio6 21 GPIO_ACTIVE_HIGH>, /* GPIO 181, INT1 */
			    <&gpio6 20 GPIO_ACTIVE_HIGH>; /* GPIO 180, INT2 */
	};
};

&dispc {
	status = "okay";
	width = <800>;
	height = <480>;
	memory-region = <&fb_mem>;
	display-controller = <&panel>;
};

/* Test pads under the battery, 1.8 V */
&uart3 {
	status = "okay";
	current-speed = <115200>;
};

/* Audio serial port to the codec */
&mcbsp2 {
	status = "okay";
};
